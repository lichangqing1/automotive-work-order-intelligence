DATABASE_URL=postgresql+psycopg://automotive:automotive@localhost:5432/automotive
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_NAMESPACE=automotive-quality
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_JIRA_REQUESTS=10
RATE_LIMIT_MUTATION_REQUESTS=30
RATE_LIMIT_READ_REQUESTS=120
# Low-cost reads remain available during Redis outages; all mutations, Jira,
# and paid AI operations fail closed.
RATE_LIMIT_READ_FAIL_OPEN=true
AI_CONCURRENCY_PER_PRINCIPAL=2
AI_CONCURRENCY_LEASE_SECONDS=180
MAX_REQUEST_BODY_BYTES=1048576
API_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Browser CORS is disabled unless explicit origins are configured.
API_CORS_ORIGINS=
API_CORS_ALLOW_CREDENTIALS=false
# Must be false in shared, staging, and production environments.
API_DOCS_ENABLED=true

LLM_PROVIDER=mock
LLM_MODEL=default
OPENAI_API_KEY=your-openai-api-key

RETRIEVAL_TOP_K=5
LOG_LEVEL=INFO

# Required for protected /api/v1 and /health/ready requests. Store only
# SHA-256 token digests in this JSON; see docs/API_AUTHENTICATION.md.
API_AUTH_PRINCIPALS_JSON=
# Server-side Streamlit credential. Never expose this value to browser code.
API_BEARER_TOKEN=

ISSUE_TRACKER=jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=QA

JIRA_REVIEW_ISSUE_TYPE=Task
JIRA_BUG_ISSUE_TYPE=Bug

JIRA_APPROVED_STATUSES=Approved,Done
JIRA_REJECTED_STATUSES=Rejected

JIRA_REQUIREMENT_KEY=QA-4
JIRA_APPROVAL_TRANSITION_NAME=Done
