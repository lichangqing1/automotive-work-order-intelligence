DATABASE_URL=postgresql+psycopg://automotive:automotive@localhost:5432/automotive
REDIS_URL=redis://localhost:6379/0

LLM_PROVIDER=mock
LLM_MODEL=default
OPENAI_API_KEY=your-openai-api-key

RETRIEVAL_TOP_K=5
LOG_LEVEL=INFO

# Required for protected /api/v1 and /health/ready requests. Store only
# SHA-256 token digests in this JSON; see docs/API_AUTHENTICATION.md.
API_AUTH_PRINCIPALS_JSON=
# Server-side Streamlit credential. Never expose this value to browser code.
API_BEARER_TOKEN=

ISSUE_TRACKER=jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=QA

JIRA_REVIEW_ISSUE_TYPE=Task
JIRA_BUG_ISSUE_TYPE=Bug

JIRA_APPROVED_STATUSES=Approved,Done
JIRA_REJECTED_STATUSES=Rejected

JIRA_REQUIREMENT_KEY=QA-4
JIRA_APPROVAL_TRANSITION_NAME=Done
